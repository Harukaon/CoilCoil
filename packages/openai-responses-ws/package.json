{
  "name": "@coilcoil/openai-responses-ws",
  "version": "0.1.0",
  "private": true,
  "description": "CoilCoil-maintained Pi extension for OpenAI Responses over persistent WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/config.js"
    },
    "./transport": {
      "types": "./src/transport.ts",
      "import": "./dist/transport.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "file:../../vendor/pi/packages/ai",
    "@earendil-works/pi-coding-agent": "file:../../vendor/pi/packages/coding-agent",
    "@types/node": "26.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
