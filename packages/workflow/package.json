{
  "name": "@suocode/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "SuoCode's Pi workflow, tools, policies, and Simplified Chinese experience",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/audit-policy.ts",
      "./extensions/bash-cwd.ts",
      "./extensions/compact-tool-render.ts",
      "./extensions/default-tools.ts",
      "./extensions/fast.ts",
      "./extensions/mcp-health.ts",
      "./extensions/project-memory.ts",
      "./extensions/response-metrics.ts",
      "./extensions/terminal.ts",
      "./extensions/todo.ts",
      "./extensions/zh-cn.ts"
    ]
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "@earendil-works/pi-tui": "0.81.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
