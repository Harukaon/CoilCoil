{
  "name": "@coilcoil/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "CoilCoil's Pi workflow, tools, policies, and Simplified Chinese experience",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/audit-policy.ts",
      "./extensions/compact-tool-render.ts",
      "./extensions/context-clearing.ts",
      "./extensions/context-transcript.ts",
      "./extensions/default-tools.ts",
      "./extensions/fast.ts",
      "./extensions/goal.ts",
      "./extensions/mcp-tools.ts",
      "./extensions/mcp-health.ts",
      "./extensions/project-memory.ts",
      "./extensions/response-metrics.ts",
      "./extensions/subagents.ts",
      "./extensions/plan.ts",
      "./extensions/terminal.ts",
      "./extensions/todo.ts",
      "./extensions/zh-cn.ts",
      "./extensions/runtime-bridge.ts"
    ]
  },
  "dependencies": {
    "@coilcoil/mcp": "0.1.0",
    "jiti": "2.7.0",
    "node-pty": "1.2.0-beta.15"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
