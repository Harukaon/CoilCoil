{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    // 一条测试直接 import workflow 的扩展源码，而那些扩展之间按 Pi 的加载方式
    // 互相写 `./x.ts`。这里只做类型检查、不产物，放行这种写法即可；不放行的话
    // `npm run check` 会卡在别人家的文件上。
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
